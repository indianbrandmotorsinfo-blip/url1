# Copy this file to ".env" on the server and change every value.
# Do not use $ or quote characters in values.

# Admin account (the single login for the dashboard).
ADMIN_USERNAME=admin
# At least 12 characters, at most 72.
ADMIN_PASSWORD=change-this-to-a-long-password

# At least 32 characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-this-to-the-output-of-openssl-rand-hex-32

# How long a login stays valid, in minutes (480 = 8 hours).
JWT_EXPIRE_MINUTES=480

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
